static func from_token(token: String) -> Id:
	var t: String = token.strip_edges()
	if t.is_empty():
		return Id.NONE
	if t.is_valid_int():
		var n: int = int(t)
		if n >= 0 and n < Id.size():
			return n as Id
		push_warning("AbilityId: id fuera de rango: %s" % t)
		return Id.NONE
	var keys: Array = Id.keys()
	# Match exacto (NIDORANfE / NIDORANmA)
	for i: int in keys.size():
		if str(keys[i]) == t:
			return i as Id
	# Case-insensitive
	var upper: String = t.to_upper()
	for i: int in keys.size():
		if str(keys[i]).to_upper() == upper:
			return i as Id
	push_error("AbilityId: no declarado '%s'" % t)
	return Id.NONE


static func to_key(id: Id) -> String:
	if id == Id.NONE:
		return ""
	return str(Id.keys()[id])
