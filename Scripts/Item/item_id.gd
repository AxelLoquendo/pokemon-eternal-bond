static func from_token(token: String) -> Id:
	var key: String = token.strip_edges().to_upper().replace("-", "_").replace(" ", "_")
	if key.is_empty():
		return Id.NONE
	return _TOKEN_TO_ID.get(key, Id.NONE) as Id

static func to_token(id: Id) -> String:
	if id == Id.NONE:
		return ""
	return Id.keys()[id]
