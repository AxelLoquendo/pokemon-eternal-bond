; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon Eternal Bond"
run/main_scene="uid://bejv0fi81rc3q"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ObjectEvent="*uid://cxja6wlmhp334"
MusicManager="*uid://sbr5dyqyca8s"
FadeScreen="*uid://bdws4uincmrrw"
WeatherManager="*uid://lllo2o5vpfc0"
WeatherRenderer="*uid://8cw434avxdrv"
MessageService="*uid://5mt3uwe5s5qb"
DayNightManager="*uid://dtt3c7ipmpc74"
GameSettings="*uid://djqhqgiq5g8ax"
NewGameState="*uid://c5n37jd4h4br7"
SessionBoot="*uid://bysss3wtausuo"
SaveService="*uid://chgcleqfvetuh"
MapCloud="*uid://dlqjummafhtky"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=480
window/size/viewport_height=320
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[editor_plugins]

enabled=PackedStringArray("res://addons/map_creator/plugin.cfg", "res://addons/map_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://Datos/": "red",
"res://Documentacion/": "purple",
"res://Escenas/": "green",
"res://Font/": "orange",
"res://Graficos/": "yellow",
"res://Scripts/": "teal",
"res://Sfx/": "pink",
"res://addons/": "gray"
}

